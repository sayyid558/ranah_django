# ===========================================================
# Contoh file konfigurasi lingkungan.
# Salin menjadi ".env" lalu sesuaikan nilainya:
#     cp .env.example .env        (Linux/Mac)
#     copy .env.example .env      (Windows)
# File .env dibaca otomatis oleh config/settings.py
# ===========================================================

# --- Keamanan -------------------------------------------------
# Ganti dengan string acak panjang saat produksi!
DJANGO_SECRET_KEY=ganti-dengan-kunci-rahasia-acak
# True = mode pengembangan, False = produksi
DJANGO_DEBUG=True
# Daftar host yang diizinkan, pisahkan dengan koma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------
# mysql  = pakai MySQL (default, sesuai kebutuhan)
# sqlite = pakai file SQLite lokal (hanya untuk uji cepat tanpa MySQL)
DB_ENGINE=mysql
DB_NAME=ranah_db
DB_USER=ranah_user
DB_PASSWORD=ranah_pass_123
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email pengingat -----------------------------------------
# Default "console": email dicetak di terminal (aman untuk uji coba).
# Untuk mengirim sungguhan ganti ke: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.go.id
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ranah@example.go.id
